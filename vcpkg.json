{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "cgaunt-plus-plus",
  "version-string": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "C++ reconstruction of the Gauntlet Dark Legacy engine.",
  "builtin-baseline": "1577f17ee57f42a0ef6d75bbb82cb37d0b76d7e8",
  "dependencies": [
    "catch2",
    "glfw3",
    "glm",
    "lz4",
    "miniaudio",
